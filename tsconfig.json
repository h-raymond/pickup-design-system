{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "@figma/code-connect/figma-types"]
  },
  "include": ["src", "stories", ".storybook", "vite.config.ts"],
  "exclude": ["src/**/*.figma.ts", "figma"]
}
